{
  "$schema": "./apps/cloudflare/node_modules/wrangler/config-schema.json",
  "name": "programkit",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./apps/cloudflare/src/worker.ts",
  "routes": [
    {
      "pattern": "programkit.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./apps/cloudflare/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRAMKIT_WORKSPACES",
        "class_name": "WorkspaceDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDurableObject"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "env": {
    "demo": {
      "routes": [
        {
          "pattern": "demo.programkit.dev",
          "custom_domain": true,
        },
      ],
      "vars": {
        "PROGRAMKIT_DEPLOYMENT_PROFILE": "hosted-demo",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PROGRAMKIT_WORKSPACES",
            "class_name": "WorkspaceDurableObject",
          },
        ],
      },
    },
    "app": {
      "routes": [
        {
          "pattern": "app.programkit.dev",
          "custom_domain": true,
        },
      ],
      "vars": {
        "PROGRAMKIT_DEPLOYMENT_PROFILE": "hosted-app",
        "PROGRAMKIT_EMAIL_FROM": "notifications@mail.programkit.dev",
        "PROGRAMKIT_SUPPORT_EMAIL": "support@programkit.dev",
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["notifications@mail.programkit.dev"],
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PROGRAMKIT_WORKSPACES",
            "class_name": "WorkspaceDurableObject",
          },
        ],
      },
    },
  },
}
