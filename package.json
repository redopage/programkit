{
  "name": "programkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://programkit.dev",
  "repository": {
    "type": "git",
    "url": "https://forge.smol.ai/andheller/programkit.git"
  },
  "bugs": {
    "url": "https://forge.smol.ai/andheller/programkit/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "setup": "npx --yes pnpm@11.20.0 install --frozen-lockfile",
    "start": "npx --yes pnpm@11.20.0 dev",
    "verify": "npx --yes pnpm@11.20.0 check",
    "cloudflare:login": "npx --yes pnpm@11.20.0 --filter @programkit/app-cloudflare exec wrangler login --use-keyring",
    "predev": "pnpm docs-site:generate",
    "dev": "pnpm --filter @programkit/app-cloudflare dev",
    "dev:cloudflare": "pnpm --filter @programkit/app-cloudflare dev",
    "build": "pnpm build:packages && tsc --noEmit && pnpm --filter @programkit/app-cloudflare build",
    "build:packages": "pnpm --filter './packages/**' build",
    "preview": "pnpm --filter @programkit/app-cloudflare preview",
    "test": "vitest run",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm test && pnpm lint && pnpm format:check && pnpm docs:check && pnpm docs-site:check && pnpm agent-plugin-source:check && pnpm build && pnpm openapi:check && pnpm plugin:validate",
    "deploy": "pnpm deploy:cloudflare",
    "deploy:cloudflare": "pnpm build && pnpm --filter @programkit/app-cloudflare exec wrangler deploy --config ../../wrangler.jsonc",
    "deploy:site": "pnpm build && pnpm --filter @programkit/app-cloudflare exec wrangler deploy --env site --config ../../wrangler.jsonc",
    "deploy:demo": "pnpm build && pnpm --filter @programkit/app-cloudflare exec wrangler deploy --env demo --config ../../wrangler.jsonc",
    "deploy:app": "pnpm build && pnpm --filter @programkit/app-cloudflare exec wrangler deploy --env app --config ../../wrangler.jsonc",
    "selfhost": "node scripts/cloudflare-self-host.mjs launch",
    "selfhost:setup": "node scripts/cloudflare-self-host.mjs setup",
    "selfhost:deploy": "node scripts/cloudflare-self-host.mjs deploy",
    "competition:preflight": "node scripts/competition-preflight.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "docs-site:generate": "node scripts/generate-docs-site.mjs",
    "docs-site:check": "node scripts/generate-docs-site.mjs --check",
    "agent-plugin-source:generate": "node scripts/generate-agent-plugin-source.mjs",
    "agent-plugin-source:check": "node scripts/generate-agent-plugin-source.mjs --check",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "airtable:setup": "pnpm --filter @programkit/core build && node scripts/airtable.mjs setup",
    "airtable:seed": "pnpm --filter @programkit/core build && node scripts/airtable.mjs seed",
    "airtable:verify": "pnpm --filter @programkit/core build && node scripts/airtable.mjs verify",
    "plugin:validate": "node scripts/validate-plugin.mjs"
  },
  "cloudflare": {
    "bindings": {
      "AIRTABLE_OAUTH_CLIENT_ID": {
        "description": "Optional. Register an Airtable OAuth integration using your deployed callback URL, then add its client ID as a Worker secret."
      },
      "AIRTABLE_OAUTH_CLIENT_SECRET": {
        "description": "Optional. Add the server-side secret from your Airtable OAuth integration. PKCE works without one."
      },
      "PROGRAMKIT_BOOTSTRAP_TOKEN": {
        "description": "Required for a self-hosted install. Enter a private setup code of at least 16 characters; the first owner must provide the same code once to claim the installation."
      }
    }
  },
  "dependencies": {
    "@programkit/agent": "workspace:*",
    "@programkit/core": "workspace:*",
    "@programkit/web": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.0.18"
  }
}
