{
  "name": "programkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @programkit/app-cloudflare dev",
    "dev:cloudflare": "pnpm --filter @programkit/app-cloudflare dev",
    "build": "pnpm build:packages && tsc --noEmit && pnpm --filter @programkit/app-cloudflare build",
    "build:packages": "pnpm --filter './packages/**' build",
    "preview": "pnpm --filter @programkit/app-cloudflare preview",
    "test": "vitest run",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm test && pnpm lint && pnpm format:check && pnpm build && pnpm plugin:validate",
    "deploy": "pnpm deploy:cloudflare",
    "deploy:cloudflare": "pnpm build && pnpm --filter @programkit/app-cloudflare exec wrangler deploy",
    "plugin:validate": "node scripts/validate-plugin.mjs"
  },
  "dependencies": {
    "@programkit/agent": "workspace:*",
    "@programkit/core": "workspace:*",
    "@programkit/web": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.0.18"
  }
}
