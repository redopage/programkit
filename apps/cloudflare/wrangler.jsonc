{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "programkit",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "vars": {
    "PROGRAMKIT_EMAIL_FROM": "notifications@programkit.dev",
  },
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRAMKIT_WORKSPACES",
        "class_name": "WorkspaceDurableObject",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "PROGRAMKIT_ASSETS",
      "bucket_name": "programkit-assets",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDurableObject"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
